{
  "name": "vite-plugin-tailwind-compat",
  "version": "0.1.1",
  "description": "A Vite plugin that brings Tailwind CSS 4 compatibility to older browsers.",
  "keywords": [
    "compatibility",
    "polyfill",
    "postcss",
    "tailwind",
    "tailwindcss",
    "vite",
    "vite-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KiriRainCat/vite-plugin-tailwind-compat"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint",
    "fix": "oxlint --fix && oxfmt && bun run check",
    "check": "tsc --noEmit",
    "build": "tsdown"
  },
  "dependencies": {
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.26"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.14",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "tailwindcss": "^4",
    "vite": "^8"
  }
}
